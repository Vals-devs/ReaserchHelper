# Application Secrets & Environment Configuration
APP_NAME=ResearchFinder
DEBUG=True
SECRET_KEY=change-me-to-random-string

# Database Configuration (Docker / PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/researchdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchdb

# Redis Caching
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=True

# External Academic & AI APIs
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key

# Midtrans Payment Gateway (Ambil dari Dashboard Midtrans https://dashboard.midtrans.com)
MIDTRANS_SERVER_KEY=SB-Mid-server-your_server_key
MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
MIDTRANS_IS_PRODUCTION=False
